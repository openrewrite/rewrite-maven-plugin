<extensions>
  <extension>
    <groupId>com.gradle</groupId>
    <artifactId>develocity-maven-extension</artifactId>
    <version>2.2.1</version>
  </extension>
  <!-- s3:// transport for deploying to the Code Genome Project bucket; AWS SDK v2, whose
       credential chain picks up AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_REGION -->
  <extension>
    <groupId>net.pennix</groupId>
    <artifactId>maven-wagon-s3v2</artifactId>
    <version>1.0.3</version>
  </extension>
</extensions>
